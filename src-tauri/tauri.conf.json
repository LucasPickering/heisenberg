{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "heisenberg",
  "version": "0.1.0",
  "identifier": "heisenberg",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Heisenberg",
        "width": 400,
        "height": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
